source "https://rubygems.org"

# This gem pins Jekyll and its plugins to the exact versions GitHub Pages
# runs in production, so what you see locally matches what gets deployed.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-redirect-from"
end
